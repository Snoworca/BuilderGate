{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node tools/ensure-react-mosaic-patch.cjs",
    "build": "node tools/with-tsc-build-lock.mjs node node_modules/typescript/bin/tsc -b && vite build",
    "postbuild": "node -e \"require('../tools/start-runtime').stageFrontendAssets()\"",
    "lint": "eslint .",
    "typecheck": "node tools/with-tsc-build-lock.mjs node node_modules/typescript/bin/tsc -b",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "lint:command-management": "eslint src/components/dialog src/components/Header src/components/ContextMenu src/components/CommandPresetManager src/components/Grid/MosaicContainer.tsx src/components/Terminal/TerminalView.tsx src/components/Terminal/TerminalContainer.tsx src/services/api.ts src/types src/utils/contextMenuBuilder.ts tests/unit/dialogGeometry.test.ts tests/unit/dialogStack.test.ts tests/unit/windowDialogContract.test.ts tests/unit/windowDialogZBand.test.ts tests/unit/messageBoxContract.test.ts tests/unit/commandPresetExecution.test.ts tests/unit/contextMenuModel.test.ts tests/unit/contextMenuGeometry.test.ts tests/unit/contextMenuNavigation.test.ts tests/unit/commandPresetPaste.test.ts tests/unit/terminalContextMenuRegisteredItems.test.ts tests/e2e/command-management-dialog.spec.ts tests/e2e/terminal-context-menu-registered-items.spec.ts",
    "test:unit:command-management": "node --experimental-strip-types --test tests/unit/dialogGeometry.test.ts tests/unit/dialogStack.test.ts tests/unit/windowDialogContract.test.ts tests/unit/windowDialogZBand.test.ts tests/unit/messageBoxContract.test.ts tests/unit/commandPresetExecution.test.ts tests/unit/contextMenuModel.test.ts tests/unit/contextMenuGeometry.test.ts tests/unit/contextMenuNavigation.test.ts tests/unit/commandPresetPaste.test.ts tests/unit/terminalContextMenuRegisteredItems.test.ts",
    "test:e2e:command-management": "playwright test tests/e2e/command-management-dialog.spec.ts --project \"Desktop Chrome\"",
    "lint:terminal-shortcuts": "eslint src/App.tsx src/components/dialog src/components/Header src/components/Terminal/TerminalContainer.tsx src/components/Terminal/TerminalRuntimeLayer.tsx src/components/TerminalShortcutManager src/services/api.ts src/types src/utils/terminalShortcutBindings.ts tests/unit/windowDialogContract.test.ts tests/unit/terminalShortcutBindings.test.ts tests/e2e/terminal-shortcut-manager.spec.ts",
    "test:unit:e2e-ownership": "node --experimental-strip-types --test tests/unit/e2eOwnershipTypecheck.test.ts tests/unit/workspaceLeakGuard.test.ts tests/unit/workspaceOwnershipCleanupMigration.test.ts tests/unit/workspaceOwnershipDiagnosticDetails.test.ts tests/unit/workspaceOwnershipExternalConfig.test.ts tests/unit/workspaceOwnershipFixture.test.ts tests/unit/workspaceOwnershipMigration.test.ts tests/unit/workspaceOwnershipPromotionMigration.test.ts tests/unit/workspaceOwnershipRegistry.test.ts tests/unit/workspaceOwnershipSpecCleanup.test.ts tests/unit/workspaceOwnershipValidationControl.test.ts",
    "test:unit:clipboard": "node --experimental-strip-types --test tests/unit/clipboardCopy.test.ts tests/unit/terminalClipboardAdapterContract.test.ts tests/unit/terminalClipboardCoordinator.test.ts tests/unit/terminalClipboardSurfaceWiring.test.ts",
    "test:unit:terminal-shortcuts": "node --experimental-strip-types --test tests/unit/windowDialogContract.test.ts tests/unit/terminalShortcutBindings.test.ts",
    "test:e2e:terminal-shortcuts": "node tools/prepare-terminal-shortcut-e2e.cjs && playwright test tests/e2e/terminal-shortcut-manager.spec.ts --project \"Desktop Chrome\"",
    "test:e2e:terminal-title-auto-tab-name": "playwright test tests/e2e/terminal-title-auto-tab-name.spec.ts --project \"Desktop Chrome\"",
    "test:e2e:issue34-capacity": "playwright test --config playwright.issue34-capacity.config.ts --project \"Desktop Chrome\"",
    "test:e2e:issue34-raise": "playwright test --config playwright.issue34-raise.config.ts --project \"Desktop Chrome\"",
    "postinstall": "patch-package",
    "preview": "vite preview",
    "test:unit:terminal-view-behavior": "tsx --tsconfig tsconfig.test.json --experimental-test-module-mocks --import ./tests/unit/assetStubLoader-register.mjs --test tests/unit/terminalViewKeyboardBehavior.test.ts tests/unit/terminalSavedSelectionDivergence.test.ts tests/unit/terminalPasteUnifiedPath.test.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/commands": "^6.10.0",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/legacy-modes": "^6.5.2",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.8",
    "@lezer/common": "^1.2.3",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.6.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.25",
    "mermaid": "^11.4.1",
    "react": "^19.2.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.2.0",
    "react-markdown": "^9.1.0",
    "react-mosaic-component": "^6.1.1",
    "react-rnd": "^10.5.3",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "shiki": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@xterm/headless": "^6.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^30.1.0",
    "patch-package": "^8.0.1",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
