{
  // Type-checks test files, which no other tsconfig covers.
  // Deliberately NOT listed in tsconfig.json "references": `npm run build` is
  // `tsc -b`, so a referenced project would make every root build script and CI
  // fail on a test-only type error. Run it via `npm run typecheck:tests`.
  //
  // "include": ["src"] is mandatory, not decorative: e2e specs never import
  // src/utils/terminalDebugCapture.ts, so without src the only `declare global`
  // in the program is a narrowed copy and the measurement becomes meaningless.
  //
  // "files" is an explicit allowlist. It used to grow one file at a time, and by
  // issue #82 it had drifted: 45 of 116 files under tests/unit/ were in no
  // tsconfig at all. It now covers every file under tests/unit/, and
  // tests/unit/tsconfigTestMembership.test.ts fails when that stops being true.
  // e2e specs are still admitted individually — currently only
  // tests/e2e/wave2-screen-repair-resync.spec.ts, whose synthetic wire frames
  // have to stay in step with the client's authority-proof types.
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["vite/client", "node"]
  },
  "include": ["src"],
