{"transport": "speckiwi-list-json", "target": "mtk-wave-1", "list": {"records": [{"id": "FR-MKB-001", "title": "\ubaa8\ubc14\uc77c \ud0a4 \ubcc0\ud658\uae30\ub294 \ud0a4 \uc774\ub984\uacfc \uc218\uc2dd\ud0a4 \uc0c1\ud0dc\ub97c xterm \ud638\ud658 \ubc14\uc774\ud2b8\ub85c \ubc14\uafbc\ub2e4", "type": "functional", "target": "mtk-wave-1", "status": "planned", "scope": "MKB", "filePath": "docs/spec/46.mobile-terminal-keyboard.srs.md", "headingLine": 35, "metadata": {"Type": "functional", "Target": "mtk-wave-1", "Status": "planned", "Priority": "high", "Tags": "-", "Risk": "medium", "Stability": "evolving", "Verification Method": "test", "GitHub Issue": "https://github.com/Snoworca/BuilderGate/issues/134", "Related Docs": "[mobile-terminal-keyboard design](../design/mobile-terminal-keyboard.html)"}, "acceptanceCriteria": [{"id": "AC-1", "text": "\ubc29\ud5a5\ud0a4\ub294 \uc218\uc2dd\ud0a4\uac00 \uc5c6\uc744 \ub54c applicationCursor \uac00 \uac70\uc9d3\uc774\uba74 ESC [ A..D, \ucc38\uc774\uba74 ESC O A..D \ub85c \ubc14\ub010\ub2e4", "checked": false, "line": 60}, {"id": "AC-2", "text": "Home/End \ub294 \uc218\uc2dd\ud0a4\uac00 \uc5c6\uc744 \ub54c ESC [ H / ESC [ F \ub85c, applicationCursor \uac00 \ucc38\uc774\uba74 ESC O H / ESC O F \ub85c \ubc14\ub010\ub2e4", "checked": false, "line": 61}, {"id": "AC-3", "text": "\ubc29\ud5a5\ud0a4\u00b7Home\u00b7End \uc5d0 \uc218\uc2dd\ud0a4\uac00 \uc788\uc73c\uba74 ESC [ 1 ; m X \ub85c \ubc14\ub00c\uace0 m = 1 + shift(1) + alt(2) + ctrl(4) \uc774\ub2e4", "checked": false, "line": 62}, {"id": "AC-4", "text": "Insert\u00b7Delete\u00b7PageUp\u00b7PageDown \uc740 ESC [ 2~ \u00b7 3~ \u00b7 5~ \u00b7 6~ \ub85c, \uc218\uc2dd\ud0a4\uac00 \uc788\uc73c\uba74 ESC [ n ; m ~ \ub85c \ubc14\ub010\ub2e4", "checked": false, "line": 63}, {"id": "AC-5", "text": "F1~F4 \ub294 ESC O P..S \ub85c, F5~F12 \ub294 ESC [ 15~ 17~ 18~ 19~ 20~ 21~ 23~ 24~ \ub85c \ubc14\ub010\ub2e4", "checked": false, "line": 64}, {"id": "AC-6", "text": "Esc\u00b7Tab\u00b7Enter\u00b7Backspace \ub294 ESC \u00b7 \\t \u00b7 \\r \u00b7 0x7f \ub85c, Shift+Tab \uc740 ESC [ Z \ub85c \ubc14\ub010\ub2e4", "checked": false, "line": 65}, {"id": "AC-7", "text": "Ctrl+\ud55c \uae00\uc790\ub294 xterm \ud45c\ub300\ub85c \ubc14\ub010\ub2e4: a..z \uc640 A..Z \u2192 0x01..0x1a(\ub300\uc18c\ubb38\uc790 \ubb34\uad00), @\u00b72\u00b7Space \u2192 0x00, [\u00b73 \u2192 0x1b, \\\u00b74 \u2192 0x1c, ]\u00b75 \u2192 0x1d, ^\u00b76 \u2192 0x1e, _\u00b7-\u00b77 \u2192 0x1f, ?\u00b78 \u2192 0x7f, \uadf8 \ubc16\uc758 \uae00\uc790\ub294 \uadf8\ub300\ub85c\uc774\uba70, \uc218\uc2dd\ud0a4\uac00 \ubd99\uc740 F1~F12 \uc640 \uc601\ubb38\uc790\uac00 \uc544\ub2cc \uae00\uc790\uc758 Shift \ub294 \uc218\uc2dd\ud0a4 \uc5c6\uc774 \uac19\uc740 \ubc14\uc774\ud2b8\ub97c \ub0b8\ub2e4", "checked": false, "line": 66}, {"id": "AC-8", "text": "Alt \ub294 \uc218\uc2dd\ud0a4 \ub9e4\uac1c\ubcc0\uc218 \ud615\uc2dd(ESC [ 1 ; m X, ESC [ n ; m ~)\uc774 \uc5c6\ub294 \ud0a4, \uace7 \ud55c \uae00\uc790\u00b7Esc\u00b7Tab\u00b7Enter\u00b7Backspace\u00b7F1~F12 \uc758 \uacb0\uacfc \uc55e\uc5d0 ESC \ud558\ub098\ub97c \ubd99\uc774\uace0, \ub9e4\uac1c\ubcc0\uc218 \ud615\uc2dd\uc774 \uc788\ub294 \ud0a4\uc5d0\ub294 \ubd99\uc774\uc9c0 \uc54a\ub294\ub2e4. Shift+\uc601\ubb38\uc790\ub294 Ctrl/Alt \ub97c \uc801\uc6a9\ud558\uae30 \uc804\uc5d0 \ub300\ubb38\uc790\ub85c \ubc14\uafbc\ub2e4", "checked": false, "line": 67}], "verificationEvidence": [], "traceLinks": [{"type": "Code", "reference": "frontend/src/utils/mobileKeyEncoder.ts", "relation": "implements", "notes": "trace_intent=addition_site", "line": 78}], "changeNotes": [{"date": "2026-10-17", "change": "Created", "reason": "add-requirement", "line": 92}], "tags": ["-"], "relatedDocs": ["docs/design/mobile-terminal-keyboard.html"], "evidenceReferences": [], "traceReferences": ["frontend/src/utils/mobileKeyEncoder.ts"], "blockStartLine": 35, "blockEndLine": 93, "sectionLines": {"Requirement": 50, "Rationale": 54, "Acceptance Criteria": 58, "Verification Evidence":