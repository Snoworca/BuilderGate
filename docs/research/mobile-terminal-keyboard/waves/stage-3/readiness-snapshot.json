{"transport": "speckiwi-list-json", "target": "mtk-wave-3", "list": {"records": [{"id": "FR-MKB-008", "title": "\ud0a4\ubcf4\ub4dc \uc804\ud658 \ubc84\ud2bc\uc740 \uc2dc\uc2a4\ud15c \ud0a4\ubcf4\ub4dc\uc640 \ud2b9\uc218 \ud0a4\ubcf4\ub4dc\ub97c \uac19\uc740 \uc790\ub9ac\uc5d0\uc11c \ubc14\uafbc\ub2e4", "type": "functional", "target": "mtk-wave-3", "status": "planned", "scope": "MKB", "filePath": "docs/spec/46.mobile-terminal-keyboard.srs.md", "headingLine": 619, "metadata": {"Type": "functional", "Target": "mtk-wave-3", "Status": "planned", "Priority": "high", "Tags": "-", "Risk": "medium", "Stability": "evolving", "Verification Method": "test", "GitHub Issue": "https://github.com/Snoworca/BuilderGate/issues/137", "Related Docs": "[mobile-terminal-keyboard design](../design/mobile-terminal-keyboard.html)"}, "acceptanceCriteria": [{"id": "AC-1", "text": "\uc2dc\uc2a4\ud15c \ud0a4\ubcf4\ub4dc\uac00 \ub5a0 \uc788\uc744 \ub54c \uc804\ud658 \ubc84\ud2bc\uc744 \ub204\ub974\uba74 \uc0c8 TerminalHandle.blurInput() \uc73c\ub85c helper textarea \uc758 \ud3ec\ucee4\uc2a4\ub97c \ud480\uace0 pendingFocusRestoreRef \ub97c \ube44\uc6b4 \ub4a4 \ud2b9\uc218 \ud0a4\ubcf4\ub4dc \ud328\ub110\uc744 \uc5f0\ub2e4", "checked": false, "line": 644}, {"id": "AC-2", "text": "\ud328\ub110 \ub192\uc774\ub294 \ub9c8\uc9c0\ub9c9\uc73c\ub85c \uc7b0 \uc2dc\uc2a4\ud15c \ud0a4\ubcf4\ub4dc inset(getLastKeyboardInset) \uc774\uace0, \uc7b0 \uac12\uc774 \uc5c6\uc73c\uba74 280 px \uc774\ub2e4", "checked": false, "line": 645}, {"id": "AC-3", "text": "\ud328\ub110\uc774 \uc5f4\ub9b0 \ub3d9\uc548 \uc804\ud658 \ubc84\ud2bc\uc744 \ub204\ub974\uba74 \uac19\uc740 \ud0ed \ucc98\ub9ac\uae30 \uc548\uc5d0\uc11c \ub3d9\uae30\uc801\uc73c\ub85c setFocusSuppressed(false) \ub85c \uc5b5\uc81c\ub97c \ud480\uace0 \uc774\uc5b4\uc11c TerminalHandle.focus() \ub97c \ubd88\ub7ec \uc2dc\uc2a4\ud15c \ud0a4\ubcf4\ub4dc\ub97c \ub2e4\uc2dc \uc62c\ub9b0 \ub4a4 \ud328\ub110\uc744 \ub2eb\ub294\ub2e4. \uc5b5\uc81c \ud50c\ub798\uadf8\ub294 React \uc0c1\ud0dc\uac00 \uc544\ub2c8\ub77c TerminalView \uc548\uc758 ref \ub85c \ub4e4\uace0 \uc788\uace0, \uc5b5\uc81c\ub97c \ud478\ub294 \uac83\uc740 \uc804\ud658 \ubc84\ud2bc(\uacfc isMobile \uc774 \uac70\uc9d3\uc774 \ub420 \ub54c)\ubfd0\uc774\ub2e4", "checked": false, "line": 646}, {"id": "AC-4", "text": "\ud328\ub110\uc774 \uc5f4\ub9b0 \ub3d9\uc548(\ud3ec\ucee4\uc2a4 \uc5b5\uc81c \uc911) \uacf5\uac1c TerminalHandle.focus() \ub97c \ud3ec\ud568\ud55c TerminalView \uc758 \ubaa8\ub4e0 \ud3ec\ucee4\uc2a4 \uc9c4\uc785\uc774 focusTerminalInput \ud55c \uacf3\uc5d0\uc11c \ub9c9\ud78c\ub2e4: TerminalRuntimeLayer \uc758 onPointerDownCapture\u00b7onClickCapture \u2192 focus, App \uc758 \ud0ed \ub798\ud37c focusTerminal, sendMobileKey \uc7ac\ud3ec\ucee4\uc2a4, MobileKeyBar \uc758 onRestoreFocus, handleClick, pending focus-restore, \ud074\ub9bd\ubcf4\ub4dc coordinator \ud3ec\ucee4\uc2a4. \uc5b5\uc81c \uc911 xterm \uc774 \uc2a4\uc2a4\ub85c helper textarea \uc5d0 \ud3ec\ucee4\uc2a4\ub97c \uc8fc\uba74 \uc989\uc2dc blur \ud55c\ub2e4", "checked": false, "line": 647}, {"id": "AC-5", "text": "\ud328\ub110\uc774 \uc5f4\ub9b0 \ub3d9\uc548 \ud0a4 \uc904\uc740 helper textarea \uac00 blur \ub41c \uc0c1\ud0dc\uc5d0\uc11c\ub3c4 \ubcf4\uc774\uba70(\ud45c\uc2dc \uc870\uac74 = \uc785\ub825 \ud3ec\ucee4\uc2a4 \ub610\ub294 \ud328\ub110 \uc5f4\ub9bc) \uc804\ud658 \ubc84\ud2bc\uc740 \uc2dc\uc2a4\ud15c \ud0a4\ubcf4\ub4dc\ub85c \ub3cc\uc544\uac00\ub294 \ud45c\uc2dc(ABC)\ub97c \ud55c\ub2e4. \ud328\ub110\uc740 \ud0a4 \uc904 \ubc14\ub85c \uc544\ub798 \ud654\uba74 \ub9e8 \uc544\ub798\uc5d0 \ubd99\uace0, \uc571 \ub808\uc774\uc544\uc6c3\uc740 \ud328\ub110 \ub192\uc774\ub9cc\ud07c \ud130\ubbf8\ub110 \uc601\uc5ed\uc744 \uc904\uc5ec \ud328\ub110\uc774 \ud130\ubbf8\ub110\uc744 \uac00\ub9ac\uc9c0 \uc54a\ub294\ub2e4", "checked": false, "line": 648}, {"id": "AC-6", "text": "isMobile \uc774 \uac70\uc9d3\uc774 \ub418\uba74 \ud328\ub110\uc744 \ub2eb\ub294\ub2e4. \ub370\uc2a4\ud06c\ud1b1 \ub3d9\uc791\uc740 \ubc14\ub00c\uc9c0 \uc54a\ub294\ub2e4", "checked": false, "line": 649}], "verificationEvidence": [], "traceLinks": [{"type": "Code", "reference": "frontend/src/components/MobileKeyboard/MobileSpecialKeyboard.tsx", "relation": "implements", "notes": "trace_intent=addition_site", "line": 660}, {"type": "Code", "reference": "frontend/src/components/Terminal/TerminalView.tsx", "relation": "implements", "notes": "trace_intent=addition_site", "line": 661}, {"type": "Code", "reference": "frontend/src/App.tsx", "relation": "implements", "notes": "trace_intent=addition_site", "line": 662}], "changeNotes": [{"date": "2026-10-18", "change": "Created", "reason": "add-requirement", "line": 676}], "tags": ["-"], "relatedDocs": ["docs/design/mobile-terminal-keyboard.html"], "evidenceReferences": [], "traceReferences": ["frontend/src/components/MobileKeyboard/MobileSpecialKeyboard.tsx", "frontend/src/components/Terminal/TerminalView.tsx", "frontend/src/App.tsx"], "blockStartLine": 619, "blockEndLine": 677, "sectionLines": {"Requirement": 634, "Rationale": 638, "Acceptance Criteria": 642, "Verification Evidence": 651, "Trace Links": 656, "Research / Analysis": 664, "Implementation Notes": 668, "Change Notes": 672}, "priority": "high", "risk": "medium", "stability": "evolving", "newWorkCandidate": true, "requirement": "\uc2dc\uc2a4\ud15c\uc740 \ud0a4 \uc904\uc758 \uc804\ud658 \ubc84\ud2bc\uc73c\ub85c \uc2dc\uc2a4\ud15c \ud0a4\ubcf4\ub4dc\ub97c \ub0b4\ub9ac\uace0 \uac19\uc740 \uc790\ub9ac\uc5d0 \ud2b9\uc218 \ud0a4\ubcf4\ub4dc \ud328\ub110\uc744 \ub744\uc6b0\uac70\ub098, \ud328\ub110\uc744 \ub2eb\uace0 \uc2dc\uc2a4\ud15c \ud0a4\ubcf4\ub4dc\ub97c \ub2e4\uc2dc \uc62c\ub824\uc57c \ud558\uba70, \ud328\ub110\uc774 \uc5f4\ub9b0 \ub3d9\uc548 \ud130\ubbf8\ub110 \uc785\ub825\uc774 \ub2e4\uc2dc \ud3ec\ucee4\uc2a4\ub97c \ubc1b\uc9c0 \uc54a\uac8c \ud574\uc57c \ud55c\ub2e4.", "rationale": "RD Client \uc758 Special Keys \ud654\uba74\ucc98\ub7fc F \ud0a4\u00b7\ubc29\ud5a5\ud0a4\u00b7\ud3b8\uc9d1 \ud0a4\ub97c \ud55c \ud654\uba74\uc5d0\uc11c \uc4f0\ub824\uba74 \uc2dc\uc2a4\ud15c \ud0a4\ubcf4\ub4dc\ub97c \ub0b4\ub9ac\uace0 \uadf8 \uc790\ub9ac\ub97c \uc368\uc57c \ud55c\ub2e4 (epic #133, #137).", "research": "- -", "implementationNotes": "- \ub514\uc790\uc778 \uac80\uc99d \ub77c\uc6b4\ub4dc 1 \uc5d0\uc11c \ud655\uc778\ud55c \uc7ac\ud3ec\ucee4\uc2a4 \uacbd\ub85c: App.tsx \ud0ed \ub798\ud37c onPointerDown \u2192 focusTerminal, TerminalView handleClick, pendingFocusRestoreRef \ubcf5\uc6d0(TerminalView \uc758 focus-restore). \ud568\uc815: iOS \ub294 \uc0ac\uc6a9\uc790 \uc81c\uc2a4\ucc98 \ucc98\ub9ac\uae30 \uc548\uc5d0\uc11c \ub3d9\uae30\uc801\uc73c\ub85c focus() \ud574\uc57c \ud0a4\ubcf4\ub4dc\uac00 \uc62c\ub77c\uc628\ub2e4."}, {"id": "FR-MKB-009", "title": "\ud2b9\uc218 \ud0a4\ubcf4\ub4dc\ub294 F \ud0a4, \ud3b8\uc9d1\u00b7\uae30\ud638 \ud0a4, \ubc29\ud5a5 \ube14\ub85d\uc744 \uc138 \uac1c\uc758 3\u00d74 \ube14\ub85d\uc73c\ub85c \ubcf4\uc5ec \uc8fc\uace0 \ub798\uce58\ub97c \uc801\uc6a9\ud574 \ubcf4\ub0b8\ub2e4", "type": "functional", "target": "mtk-wave-3", "status": "planned", "scope": "MKB", "filePath": "docs/spec/46.mobile-terminal-keyboard.srs.md", "headingLine": 678, "metadata": {"Type": "functional", "Target": "mtk-wave-3", "Status": "planned", "Priority": "high", "Tags": "-", "Risk": "medium", "Stability": "evolving", "Verification Method": "test", "GitHub Issue": "https://github.com/Snoworca/BuilderGate/issues/137", "Related Docs": "[mobile-terminal-keyboard design](../design/mobile-terminal-keyboard.html)"}, "acceptanceCriteria": [{"id": "AC-1", "text": "\ub9e8 \uc704 \uc904\uc740 Esc, Tab, Ctrl, Alt, Shift \uc774\uace0 Ctrl\u00b7Alt\u00b7Shift \ub294 \uc7a0\uae00 \uc218 \uc788\ub294 \ud0a4(LatchKey)\uc774\ub2e4", "checked": false, "line": 703}, {"id": "AC-2", "text": "\uc67c\ucabd \ube14\ub85d\uc740 F1 F2 F3 / F4 F5 F6 / F7 F8 F9 / F10 F11 F12 \uc774\ub2e4", "checked": false, "line": 704}, {"id": "AC-3", "text": "\uac00\uc6b4\ub370 \ube14\ub85d\uc740 \u232b / | / ~ * - / ` : + / _ = Enter \uc774\ub2e4", "checked": false, "line": 705}, {"id": "AC-4", "text": "\uc624\ub978\ucabd \ube14\ub85d\uc740 Home \u2191 PgUp / \u2190 (\ube48\uce78) \u2192 / End \u2193 PgDn / Ins Del \uc22b\uc790\ud328\ub4dc \uc774\uace0 \ubc29\ud5a5\ud0a4\ub294 \uc2ed\uc790 \ubaa8\uc591\uc73c\ub85c \ub2e4\ub978 \ud0a4\ubcf4\ub2e4 \ub208\uc5d0 \ub748\ub2e4", "checked": false, "line": 706}, {"id": "AC-5", "text": "\ubaa8\ub4e0 \ud0a4\ub294 \ud65c\uc131 \ud130\ubbf8\ub110\uc758 \uc571 \ucee4\uc11c \ubaa8\ub4dc\uc640 \ub798\uce58 \uc0c1\ud0dc\ub85c encodeMobileKey \ud55c \uacb0\uacfc\ub97c \ubcf4\ub0b4\uace0 once \uc218\uc2dd\ud0a4\ub97c \uc18c\ubaa8\ud55c\ub2e4", "checked": false, "line": 707}, {"id": "AC-6", "text": "\ud328\ub110 \ud0a4\ub294 --ctl-touch(44 px) \uc774\uc0c1\uc758 \ud130\uce58 \ud06c\uae30\ub97c \uac00\uc9c0\uba70 Win\u00b7AltGr\u00b7\ub9c8\uc6b0\uc2a4\u00b7\uc2a4\ud06c\ub9b0\uc0f7 \ud0a4\ub294 \uc5c6\ub2e4. \ud328\ub110 \ud0a4\ub294 \ud0a4 \uc904\uacfc \uac19\uc740 \ub204\ub984 \ucc98\ub9ac\ub97c \uc4f4\ub2e4: pointerdown\u00b7mousedown \uae30\ubcf8 \ub3d9\uc791\uc744 \ub9c9\uace0 pointerup \uc5d0\uc11c \ub3d9\uc791\ud558\uba70 8 px \ub118\uac8c \ub04c\uba74 \ubcf4\ub0b4\uc9c0 \uc54a\uace0, Ctrl\u00b7Alt\u00b7Shift \ub294 \ud0a4 \uc904\uacfc \uac19\uc740 LatchKey \ucef4\ud3ec\ub10c\ud2b8\ub2e4", "checked": false, "line": 708}, {"id": "AC-7", "text": "\ud0a4 \uc774\ub984\uc740 ASCII \uc0c1\uc218\uc774\uace0 aria-label \ubb38\uc7a5\uc740 i18n \uce74\ud0c8\ub85c\uadf8\ub97c \uac70\uce5c\ub2e4", "checked": false, "line": 709}], "verificationEvidence": [], "traceLinks": [{"type": "Code", "reference": "frontend/src/components/MobileKeyboard/MobileSpecialKeyboard.tsx", "relation": "implements", "notes": "trace_intent=addition_site", "line": 720}], "changeNotes": [{"date": "2026-10-18", "change": "Created", "reason": "add-requirement", "line": 734}], "tags": ["-"], "relatedDocs": ["docs/design/mobile-terminal-keyboard.html"], "evidenceReferences": [], "traceReferences": ["frontend/src/components/MobileKeyboard/MobileSpecialKeyboard.tsx"], "blockStartLine": 678, "blockEndLine": 735, "sectionLines": {"Requirement": 693, "Rationale": 697, "Acceptance Criteria": 701, "Verification Evidence": 711, "Trace Links": 716, "Research / Analysis": 722, "Implementation Notes": 726, "Change Notes": 730}, "priority": "high", "risk": "medium", "stability": "evolving", "newWorkCandidate": true, "requirement": "\uc2dc\uc2a4\ud15c\uc740 \ud2b9\uc218 \ud0a4\ubcf4\ub4dc \ud328\ub110\uc5d0 \ub9e8 \uc704 \uc904 Esc\u00b7Tab\u00b7Ctrl\u00b7Alt\u00b7Shift \uc640 \uadf8 \uc544\ub798 F1~F12 \ube14\ub85d, \ud3b8\uc9d1\u00b7\uae30\ud638 \ube14\ub85d, \ubc29\ud5a5 \ube14\ub85d\uc744 \ub450\uace0, \ubaa8\ub4e0 \ud0a4\ub97c \ubcc0\ud658\uae30\uc640 \ub798\uce58\ub97c \uac70\uccd0 \uae30\uc874 sendInput \uacbd\ub85c\ub85c \ubcf4\ub0b4\uc57c \ud55c\ub2e4.", "rationale": "\ub514\uc790\uc778 \uc2dc\uc548 \u2461 \ud654\uba74\uacfc RD Client Special Keys \ub97c \ub530\ub978\ub2e4 (epic #133).", "research": "- -", "implementationNotes": "- -"}, {"id": "FR-MKB-010", "title": "\ud2b9\uc218 \ud0a4\ubcf4\ub4dc\uc758 \uc624\ub978\ucabd \ube14\ub85d\uc740 \uc22b\uc790\ud328\ub4dc\ub85c \ubc14\uafc0 \uc218 \uc788\uace0 \uadf8 \uc120\ud0dd\uc744 \uae30\uc5b5\ud55c\ub2e4", "type": "functional", "target": "mtk-wave-3", "status": "planned", "scope": "MKB", "filePath": "docs/spec/46.mobile-terminal-keyboard.srs.md", "headingLine": 736, "metadata": {"Type": "functional", "Target": "mtk-wave-3", "Status": "planned", "Priority": "medium", "Tags": "-", "Risk": "medium", "Stability": "evolving", "Verification Method": "test", "GitHub Issue": "https://github.com/Snoworca/BuilderGate/issues/138", "Related Docs": "[mobile-terminal-keyboard design](../design/mobile-terminal-keyboard.html)"}, "acceptanceCriteria": [{"id": "AC-1", "text": "\uc22b\uc790\ud328\ub4dc \ud0a4\ub97c \ub204\ub974\uba74 \uc624\ub978\ucabd \ube14\ub85d\ub9cc 7 8 9 / 4 5 6 / 1 2 3 / 0 . \ubc29\ud5a